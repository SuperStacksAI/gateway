# Postgres (same as your OpenSaaS app)
DATABASE_URL=postgresql://user:password@host:5432/opensaas

# Redis (started by docker compose, or your own)
REDIS_URL=redis://localhost:6379

# Provider you're subscribed to
# Examples:
#   Together AI:    https://api.together.xyz/v1
#   OpenAI:         https://api.openai.com/v1
#   Fireworks:      https://api.fireworks.ai/inference/v1
#   Groq:           https://api.groq.com/chat/openai/v1
PROVIDER_BASE_URL=https://api.together.xyz/v1
PROVIDER_API_KEY=your-provider-api-key

# Per-1M-token pricing (what you charge users)
INPUT_PRICE_PER_M=0.15
OUTPUT_PRICE_PER_M=0.60

# Rate limits per user
RPM_LIMIT=60
