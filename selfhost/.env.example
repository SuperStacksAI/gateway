# Copy to .env and edit. Loaded by the scripts (export/source before running).
# See recipe.md for the pinned B300 / T4 configurations.

# --- Model (prod: DeepSeek V4.1) ---
# -1017 is the recommended checkpoint (2026-10-17). Also: ...V4.1-Flash (0909).
MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash-1017
SERVED_NAME=deepseek-ai/DeepSeek-V4.1-Flash-1017

# --- Dry-run profile (small, ~170GB V4-Flash) --- swap the two lines above for:
# MODEL_ID=deepseek-ai/DeepSeek-V4-Flash
# SERVED_NAME=deepseek-v4-flash
# IMAGE=lmsysorg/sglang:dev-dsv41

# --- Tiny profile (cheap-GPU script test) --- swap the top lines for:
# MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# SERVED_NAME=qwen-tiny
# IMAGE=lmsysorg/sglang:latest   # standard image; works on T4/Turing
# TP_SIZE=1
# EP_SIZE=1
# CONTEXT_LENGTH=32768
# MEM_FRACTION=0.80
# CHUNKED_PREFILL=8192
# MAX_RUNNING=16

# --- Serving ---
PORT=30000
CONTEXT_LENGTH=262144
TP_SIZE=8
EP_SIZE=8
DP_SIZE=1
MEM_FRACTION=0.92
CHUNKED_PREFILL=16384
MAX_RUNNING=32
API_KEY=change-me-selfhost-key

# --- Engine ---
# V4.1 is not in an SGLang release yet -> preview image.
IMAGE=lmsysorg/sglang:dev-dsv41
# B300 recipe flags (see recipe.md). Leave EMPTY for the tiny test.
EXTRA_ARGS="--trust-remote-code --attention-backend dsv4 --enable-deepseek-v4-fp4-indexer --kv-cache-dtype fp8_e4m3 --page-size 256 --swa-full-tokens-ratio 0.15 --cuda-graph-max-bs-decode 64 --speculative-algorithm DSPARK --speculative-dspark-block-size 5"

# --- Hugging Face (not required: V4.1 is MIT/public) ---
HF_TOKEN=
# On RunPod, point this at the network volume: /workspace/hf
HF_CACHE=$HOME/.cache/huggingface

# --- LiteLLM binding (see litellm-integration.md) ---
# SELFHOST_DS_KEY=<the SGLang API_KEY above>
# SELFHOST_MODEL_NAME=deepseek-v4.1
