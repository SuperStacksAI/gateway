# Copy to .env and edit.

# cloudflared mode: quick | token | config
MODE=quick

# Local SGLang port to expose
SGLANG_PORT=30000

# MODE=token: tunnel token from the Cloudflare dashboard
CF_TOKEN=

# MODE=config: path to the cloudflared config.yml
CF_CONFIG=~/.cloudflared/config.yml

# Public hostname (named tunnel) — used in docs / LiteLLM api_base
CF_HOSTNAME=ds.example.com

# Optional Cloudflare Access service token (if used); the gateway sends these
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
