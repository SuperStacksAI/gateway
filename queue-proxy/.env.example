# Upstream LiteLLM (private/internal at cutover; localhost for local dev)
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-...

PORT=8080

# Queue behaviour
MAX_WAIT_SECONDS=120
BUDGET_POLL_SECONDS=5
SCHEDULER_TICK_SECONDS=0.05
WINDOW_SECONDS=60

# Caches / fallbacks
AUTH_CACHE_TTL=30
USER_CACHE_TTL=10
DEFAULT_KEY_RPM=60
DEFAULT_USER_RPM=0

# Only these paths are queued; everything else is proxied straight through.
INFERENCE_PATHS=/v1/chat/completions,/v1/completions
