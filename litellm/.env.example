# Provider you're subscribed to
# Examples:
#   Together AI:    https://api.together.xyz/v1
#   OpenAI:         https://api.openai.com/v1
#   Fireworks:      https://api.fireworks.ai/inference/v1
#   Groq:           https://api.groq.com/chat/openai/v1
PROVIDER_BASE_URL=https://api.together.xyz/v1
PROVIDER_API_KEY=your-provider-api-key

# Upstream model to proxy (fill in your model, e.g. meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo)
UPSTREAM_MODEL=

# Admin key for LiteLLM master auth
LITELLM_MASTER_KEY=sk-admin-change-me